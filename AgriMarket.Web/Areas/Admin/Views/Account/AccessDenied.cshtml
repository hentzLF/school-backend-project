@{
    ViewData["Title"] = Localizer["AccessDenied"].Value;
}
<div class="container mt-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <h2 class="text-danger">@Localizer["AccessDenied"]</h2>
            <p class="text-muted">@Localizer["NoPermissionToViewPage"]</p>
            <a asp-area="Admin" asp-controller="Account" asp-action="Login" class="btn btn-primary">@Localizer["BackToLogin"]</a>
        </div>
    </div>
</div>
