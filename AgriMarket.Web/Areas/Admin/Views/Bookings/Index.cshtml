@using AgriMarket.Domain.Enums
@model BookingListViewModel
@{ ViewData["Title"] = "Bookings"; }

<div class="d-flex align-items-center justify-content-between mb-4">
    <h4 class="mb-0">Bookings <span class="badge text-bg-secondary fs-6">@Model.TotalCount</span></h4>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-action="Index" class="btn btn-sm @(Model.FilterStatus == null ? "btn-secondary" : "btn-outline-secondary")">All</a>
        @foreach (var status in Enum.GetValues<BookingStatus>())
        {
            <a asp-action="Index" asp-route-status="@status"
               class="btn btn-sm @(Model.FilterStatus == status ? "btn-primary" : "btn-outline-primary")">@status</a>
        }
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Client</th>
                    <th>Listing</th>
                    <th>Status</th>
                    <th>Price</th>
                    <th>Area (ha)</th>
                    <th>Created</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var booking in Model.Bookings)
                {
                    <tr>
                        <td>@booking.ClientName</td>
                        <td>@booking.ListingTitle</td>
                        <td><span class="badge text-bg-primary">@booking.Status</span></td>
                        <td>€@booking.TotalPrice.ToString("0.00")</td>
                        <td>@booking.AreaInHectares.ToString("0.00")</td>
                        <td>@booking.CreatedAt.ToString("dd MMM yyyy")</td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@booking.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                        </td>
                    </tr>
                }
                @if (!Model.Bookings.Any())
                {
                    <tr><td colspan="7" class="text-muted text-center py-3">No bookings found</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
