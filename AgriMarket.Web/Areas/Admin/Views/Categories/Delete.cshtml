@model CategoryListItemViewModel
@{ ViewData["Title"] = Localizer["DeleteCategory"].Value; }

<div class="mb-4">
    <h4>@Localizer["DeleteCategory"]</h4>
    <p class="text-muted">@Localizer["ConfirmDeleteCategory"]</p>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <div>@error.ErrorMessage</div>
        }
    </div>
}

@if (Model.ListingsCount > 0)
{
    <div class="alert alert-warning">
        @Html.Raw(Localizer["CategoryHasListings", Model.ListingsCount].Value)
    </div>
}

<div class="card border-danger mb-4" style="max-width: 500px;">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">@Localizer["Name"]</dt>
            <dd class="col-sm-8">@Model.Name</dd>
            <dt class="col-sm-4">@Localizer["Description"]</dt>
            <dd class="col-sm-8">@(Model.Description ?? "—")</dd>
            <dt class="col-sm-4">@Localizer["Listings"]</dt>
            <dd class="col-sm-8">@Model.ListingsCount</dd>
        </dl>
    </div>
</div>

<div class="d-flex gap-2">
    @if (Model.ListingsCount == 0)
    {
        <form asp-action="Delete" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <button type="submit" class="btn btn-danger">@Localizer["Delete"]</button>
        </form>
    }
    <a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Cancel"]</a>
</div>
