@model CategoryListViewModel
@{ ViewData["Title"] = Localizer["Categories"].Value; }

<div class="d-flex align-items-center justify-content-between mb-4">
    <h4 class="mb-0">@Localizer["Categories"] <span class="badge text-bg-secondary fs-6">@Model.TotalCount</span></h4>
    <a asp-action="Create" class="btn btn-sm btn-primary">@Localizer["NewCategory"]</a>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>@Localizer["Name"]</th>
                    <th>@Localizer["Description"]</th>
                    <th>@Localizer["Listings"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var cat in Model.Categories)
                {
                    <tr>
                        <td>@cat.Name</td>
                        <td>@(cat.Description ?? "—")</td>
                        <td>@cat.ListingsCount</td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@cat.Id" class="btn btn-sm btn-outline-primary">@Localizer["Edit"]</a>
                            <a asp-action="Delete" asp-route-id="@cat.Id" class="btn btn-sm btn-outline-danger">@Localizer["Delete"]</a>
                        </td>
                    </tr>
                }
                @if (!Model.Categories.Any())
                {
                    <tr><td colspan="4" class="text-muted text-center py-3">@Localizer["NoCategoriesFound"]</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
