@model CategoryListViewModel
@{ ViewData["Title"] = "Categories"; }

<div class="d-flex align-items-center justify-content-between mb-4">
    <h4 class="mb-0">Categories <span class="badge text-bg-secondary fs-6">@Model.TotalCount</span></h4>
    <a asp-action="Create" class="btn btn-sm btn-primary">+ New Category</a>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Listings</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var cat in Model.Categories)
                {
                    <tr>
                        <td>@cat.Name</td>
                        <td>@(cat.Description ?? "—")</td>
                        <td>@cat.ListingsCount</td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@cat.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                            <a asp-action="Delete" asp-route-id="@cat.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                        </td>
                    </tr>
                }
                @if (!Model.Categories.Any())
                {
                    <tr><td colspan="4" class="text-muted text-center py-3">No categories found</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
