@model ListingListViewModel
@{ ViewData["Title"] = Localizer["Listings"].Value; }

<div class="d-flex align-items-center justify-content-between mb-4">
    <h4 class="mb-0">@Localizer["Listings"] <span class="badge text-bg-secondary fs-6">@Model.TotalCount</span></h4>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-sm @(Model.FilterActive == null ? "btn-secondary" : "btn-outline-secondary")">@Localizer["All"]</a>
        <a asp-action="Index" asp-route-active="true" class="btn btn-sm @(Model.FilterActive == true ? "btn-success" : "btn-outline-success")">@Localizer["Active"]</a>
        <a asp-action="Index" asp-route-active="false" class="btn btn-sm @(Model.FilterActive == false ? "btn-danger" : "btn-outline-danger")">@Localizer["Inactive"]</a>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>@Localizer["Title"]</th>
                    <th>@Localizer["Provider"]</th>
                    <th>@Localizer["Category"]</th>
                    <th>@Localizer["PricePerHa"]</th>
                    <th>@Localizer["Status"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var listing in Model.Listings)
                {
                    <tr>
                        <td>@listing.Title</td>
                        <td>@listing.ProviderName</td>
                        <td>@listing.CategoryName</td>
                        <td>&euro;@listing.PricePerHectare.ToString("0.00")</td>
                        <td>
                            @if (listing.IsActive)
                            {
                                <span class="badge text-bg-success">@Localizer["Active"]</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">@Localizer["Inactive"]</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@listing.Id" class="btn btn-sm btn-outline-secondary">@Localizer["Details"]</a>
                        </td>
                    </tr>
                }
                @if (!Model.Listings.Any())
                {
                    <tr><td colspan="6" class="text-muted text-center py-3">@Localizer["NoListingsFound"]</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
