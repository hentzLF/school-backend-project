@using AgriMarket.Domain.Enums
@model PaymentDetailViewModel
@{ ViewData["Title"] = "Payment Details"; }

<div class="d-flex align-items-center justify-content-between mb-4">
    <h4 class="mb-0">Payment Details</h4>
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Back</a>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="row g-4">
    <div class="col-md-6">
        <div class="card mb-4">
            <div class="card-header">Payment Info</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5">Status</dt>
                    <dd class="col-sm-7">
                        @{
                            var badgeClass = Model.Status switch
                            {
                                PaymentStatus.Held => "text-bg-warning",
                                PaymentStatus.Released => "text-bg-success",
                                PaymentStatus.Refunded => "text-bg-info",
                                PaymentStatus.Disputed => "text-bg-danger",
                                _ => "text-bg-secondary"
                            };
                        }
                        <span class="badge @badgeClass">@Model.Status</span>
                    </dd>
                    <dt class="col-sm-5">Amount</dt>
                    <dd class="col-sm-7">€@Model.Amount.ToString("0.00")</dd>
                    <dt class="col-sm-5">Platform Fee</dt>
                    <dd class="col-sm-7">€@Model.PlatformFee.ToString("0.00")</dd>
                    <dt class="col-sm-5">Created</dt>
                    <dd class="col-sm-7">@Model.CreatedAt.ToString("dd MMM yyyy HH:mm")</dd>
                    <dt class="col-sm-5">Released</dt>
                    <dd class="col-sm-7">@(Model.ReleasedAt?.ToString("dd MMM yyyy HH:mm") ?? "—")</dd>
                </dl>
            </div>
        </div>

        <div class="card">
            <div class="card-header">Booking &amp; Parties</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5">Booking Status</dt>
                    <dd class="col-sm-7"><span class="badge text-bg-primary">@Model.BookingStatus</span></dd>
                    <dt class="col-sm-5">Listing</dt>
                    <dd class="col-sm-7">
                        <a asp-controller="Listings" asp-action="Details" asp-route-id="@Model.BookingId">@Model.ListingTitle</a>
                    </dd>
                    <dt class="col-sm-5">Client</dt>
                    <dd class="col-sm-7">@Model.ClientName</dd>
                    <dt class="col-sm-5">Provider</dt>
                    <dd class="col-sm-7">@Model.ProviderName</dd>
                </dl>
                <a asp-controller="Bookings" asp-action="Details" asp-route-id="@Model.BookingId" class="btn btn-sm btn-outline-primary mt-2">View Booking</a>
            </div>
        </div>
    </div>

    @if (Model.Status == PaymentStatus.Disputed)
    {
        <div class="col-md-6">
            <div class="card border-warning">
                <div class="card-header text-bg-warning">Resolve Dispute</div>
                <div class="card-body">
                    <p class="text-muted mb-3">Choose how to resolve this disputed payment.</p>
                    <form asp-action="Resolve" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="PaymentId" value="@Model.Id" />

                        <div class="d-flex gap-2">
                            <button type="submit" name="Resolution" value="Release" class="btn btn-success">
                                Release Payment
                            </button>
                            <button type="submit" name="Resolution" value="Refund" class="btn btn-warning">
                                Refund Payment
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
</div>
