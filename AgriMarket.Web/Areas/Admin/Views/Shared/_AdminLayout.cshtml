<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AgriMarket Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body { display: flex; min-height: 100vh; flex-direction: column; }
        .admin-wrapper { display: flex; flex: 1; }
        .admin-sidebar {
            width: 240px;
            min-height: 100vh;
            flex-shrink: 0;
        }
        .admin-sidebar .sidebar-brand {
            padding: 1rem 1.5rem;
            font-weight: 700;
            font-size: 1.1rem;
            display: block;
            text-decoration: none;
        }
        .admin-sidebar .nav-link {
            padding: .6rem 1.5rem;
            border-radius: 0;
        }
        .admin-main { flex: 1; display: flex; flex-direction: column; }
        .admin-topbar {
            padding: .6rem 1.5rem;
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 1rem;
        }
        .admin-content { padding: 1.5rem; flex: 1; }
    </style>
</head>
<body>
<div class="admin-wrapper">
    <nav class="admin-sidebar d-flex flex-column">
        <a class="sidebar-brand" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">AgriMarket Admin</a>
        <ul class="nav flex-column mt-2">
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")"
                   asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                    @Localizer["Dashboard"]
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Users" ? "active" : "")"
                   asp-area="Admin" asp-controller="Users" asp-action="Index">
                    @Localizer["Users"]
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Listings" ? "active" : "")"
                   asp-area="Admin" asp-controller="Listings" asp-action="Index">
                    @Localizer["Listings"]
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Bookings" ? "active" : "")"
                   asp-area="Admin" asp-controller="Bookings" asp-action="Index">
                    @Localizer["Bookings"]
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Categories" ? "active" : "")"
                   asp-area="Admin" asp-controller="Categories" asp-action="Index">
                    @Localizer["Categories"]
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Payments" ? "active" : "")"
                   asp-area="Admin" asp-controller="Payments" asp-action="Index">
                    @Localizer["Payments"]
                </a>
            </li>
        </ul>
    </nav>
    <div class="admin-main">
        <div class="admin-topbar">
            <partial name="_LanguageSwitcher" />
            <span class="text-muted small">@User.Identity?.Name</span>
            <form asp-area="Admin" asp-controller="Account" asp-action="Logout" method="post" class="mb-0">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-sm btn-outline-secondary">@Localizer["SignOut"]</button>
            </form>
        </div>
        <div class="admin-content">
            @RenderBody()
        </div>
    </div>
</div>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
