@model UserListItemViewModel
@{ ViewData["Title"] = "Delete User"; }

<div class="d-flex align-items-center justify-content-between mb-4">
    <h4 class="mb-0">Delete User</h4>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Cancel</a>
</div>

<div class="card border-danger" style="max-width: 520px;">
    <div class="card-header text-bg-danger">Confirm Deletion</div>
    <div class="card-body">
        <p class="mb-3">Are you sure you want to delete this user? This action cannot be undone.</p>
        <dl class="row mb-3">
            <dt class="col-sm-4">Email</dt>
            <dd class="col-sm-8">@Model.Email</dd>
            <dt class="col-sm-4">Profiles</dt>
            <dd class="col-sm-8">@Model.ProfilesCount</dd>
            <dt class="col-sm-4">Created</dt>
            <dd class="col-sm-8">@Model.CreatedAt.ToString("dd MMM yyyy")</dd>
            <dt class="col-sm-4">Status</dt>
            <dd class="col-sm-8">
                @if (Model.IsLocked)
                {
                    <span class="badge text-bg-danger">Locked</span>
                }
                else
                {
                    <span class="badge text-bg-success">Active</span>
                }
            </dd>
        </dl>
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary ms-2">Cancel</a>
        </form>
    </div>
</div>
