@model UserDetailViewModel
@{ ViewData["Title"] = Localizer["UserDetails"].Value; }

<div class="d-flex align-items-center justify-content-between mb-4">
    <h4 class="mb-0">@Localizer["UserDetails"]</h4>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm">@Localizer["Edit"]</a>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger btn-sm">@Localizer["Delete"]</a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">@Localizer["Back"]</a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header">@Localizer["Account"]</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">@Localizer["Email"]</dt>
                    <dd class="col-sm-8">@Model.Email</dd>
                    <dt class="col-sm-4">@Localizer["Created"]</dt>
                    <dd class="col-sm-8">@Model.CreatedAt.ToString("dd MMM yyyy HH:mm")</dd>
                    <dt class="col-sm-4">@Localizer["Status"]</dt>
                    <dd class="col-sm-8">
                        @if (Model.IsLocked)
                        {
                            <span class="badge text-bg-danger">@Localizer["LockedUntil", Model.LockoutEnd?.ToString("dd MMM yyyy") ?? ""]</span>
                        }
                        else
                        {
                            <span class="badge text-bg-success">@Localizer["Active"]</span>
                        }
                    </dd>
                </dl>
            </div>
            <div class="card-footer d-flex gap-2">
                @if (Model.IsLocked)
                {
                    <form asp-action="Unlock" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-success">@Localizer["Unlock"]</button>
                    </form>
                }
                else
                {
                    <form asp-action="Lock" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-warning">@Localizer["Lock"]</button>
                    </form>
                }
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header">@Localizer["Activity"]</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-6">@Localizer["Bookings"]</dt>
                    <dd class="col-sm-6">@Model.BookingsCount</dd>
                    <dt class="col-sm-6">@Localizer["Listings"]</dt>
                    <dd class="col-sm-6">@Model.ListingsCount</dd>
                    <dt class="col-sm-6">@Localizer["Profiles"]</dt>
                    <dd class="col-sm-6">@Model.Profiles.Count()</dd>
                </dl>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">@Localizer["Profiles"]</div>
    <div class="card-body p-0">
        <table class="table table-sm mb-0">
            <thead class="table-light">
                <tr>
                    <th>@Localizer["Name"]</th>
                    <th>@Localizer["Roles"]</th>
                    <th>@Localizer["Bio"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var profile in Model.Profiles)
                {
                    <tr>
                        <td>@profile.FirstName @profile.LastName</td>
                        <td>
                            @foreach (var role in profile.Roles)
                            {
                                <span class="badge text-bg-primary me-1">@role</span>
                            }
                        </td>
                        <td class="text-muted">@(profile.Bio ?? "-")</td>
                    </tr>
                }
                @if (!Model.Profiles.Any())
                {
                    <tr><td colspan="3" class="text-muted text-center py-3">@Localizer["NoProfiles"]</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
