@model UserListViewModel
@{ ViewData["Title"] = Localizer["Users"].Value; }

<div class="d-flex align-items-center justify-content-between mb-4">
    <h4 class="mb-0">@Localizer["Users"] <span class="badge text-bg-secondary fs-6">@Model.TotalCount</span></h4>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>@Localizer["Email"]</th>
                    <th>@Localizer["Profiles"]</th>
                    <th>@Localizer["Roles"]</th>
                    <th>@Localizer["Created"]</th>
                    <th>@Localizer["Status"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model.Users)
                {
                    <tr>
                        <td>@user.Email</td>
                        <td>@user.ProfilesCount</td>
                        <td>
                            @foreach (var role in user.Roles)
                            {
                                <span class="badge text-bg-primary me-1">@role</span>
                            }
                        </td>
                        <td>@user.CreatedAt.ToString("dd MMM yyyy")</td>
                        <td>
                            @if (user.IsLocked)
                            {
                                <span class="badge text-bg-danger">@Localizer["Locked"]</span>
                            }
                            else
                            {
                                <span class="badge text-bg-success">@Localizer["Active"]</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@user.Id" class="btn btn-sm btn-outline-secondary">@Localizer["Details"]</a>
                        </td>
                    </tr>
                }
                @if (!Model.Users.Any())
                {
                    <tr><td colspan="6" class="text-muted text-center py-3">@Localizer["NoUsersFound"]</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
