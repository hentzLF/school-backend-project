@{
    ViewData["Title"] = "Access Denied";
}
<div class="container py-5 text-center">
    <h2 class="mb-3">Access Denied</h2>
    <p class="text-muted mb-4">You don't have permission to access this page.</p>
    <a asp-area="Client" asp-controller="Listings" asp-action="Index" class="btn btn-success me-2">Browse Listings</a>
    <a asp-area="Client" asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary">Sign In</a>
</div>
