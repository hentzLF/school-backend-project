@model AgriMarket.Web.Areas.Client.ViewModels.Messaging.ConversationDetailViewModel
@{
    ViewData["Title"] = Localizer["Messaging_Conversations"].Value;
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <h4 class="mb-0">@Model.ParticipantName</h4>
    <div>
        @if (Model.BookingId.HasValue)
        {
            <a asp-area="Client" asp-controller="Bookings" asp-action="Details"
               asp-route-id="@Model.BookingId" class="btn btn-sm btn-outline-secondary me-2">
                @Localizer["Messaging_ViewBooking"]
            </a>
        }
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">@Localizer["Back"]</a>
    </div>
</div>

@if (Model.TotalPages > 1 && Model.CurrentPage < Model.TotalPages)
{
    <div class="text-center mb-3">
        <a asp-action="Details" asp-route-id="@Model.ConversationId" asp-route-page="@(Model.CurrentPage + 1)"
           class="btn btn-sm btn-outline-secondary">@Localizer["Messaging_LoadOlderMessages"]</a>
    </div>
}

<div class="card mb-3">
    <div class="card-body" style="max-height: 500px; overflow-y: auto;">
        @if (!Model.Messages.Any())
        {
            <p class="text-muted text-center">@Localizer["Messaging_NoMessages"]</p>
        }
        else
        {
            @foreach (var message in Model.Messages)
            {
                <div class="d-flex @(message.IsOwnMessage ? "justify-content-end" : "justify-content-start") mb-2">
                    <div class="@(message.IsOwnMessage ? "bg-primary text-white" : "bg-light") rounded p-2"
                         style="max-width: 75%;">
                        @if (!message.IsOwnMessage)
                        {
                            <small class="fw-bold d-block">@message.SenderName</small>
                        }
                        <p class="mb-1">@message.Content</p>
                        <small class="@(message.IsOwnMessage ? "text-white-50" : "text-muted")">
                            @message.SentAt.ToString("dd MMM yyyy HH:mm")
                        </small>
                    </div>
                </div>
            }
        }
    </div>
</div>

<div class="card">
    <div class="card-body">
        <form asp-area="Client" asp-controller="Messaging" asp-action="SendMessage" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ConversationId" value="@Model.ConversationId" />
            <div class="input-group">
                <input type="text" name="Content" class="form-control"
                       placeholder="@Localizer["Messaging_MessagePlaceholder"]" required />
                <button type="submit" class="btn btn-primary">@Localizer["Messaging_Send"]</button>
            </div>
        </form>
    </div>
</div>
