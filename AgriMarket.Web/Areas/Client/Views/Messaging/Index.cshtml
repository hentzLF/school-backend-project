@model AgriMarket.Web.Areas.Client.ViewModels.Messaging.ConversationListViewModel
@{
    ViewData["Title"] = Localizer["Messaging_Conversations"].Value;
}

<div class="row justify-content-center">
    <div class="col-lg-7 col-md-9">
        <h4 class="mb-3">@Localizer["Messaging_Conversations"]</h4>

        @if (!Model.Conversations.Any())
        {
            <div class="text-center text-muted py-5">
                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="currentColor" viewBox="0 0 16 16" class="mb-3 opacity-50">
                    <path d="M2.678 11.894a1 1 0 0 1 .287.801 11 11 0 0 1-.398 2c1.395-.323 2.247-.697 2.634-.893a1 1 0 0 1 .71-.074A8 8 0 0 0 8 14c3.996 0 7-2.807 7-6s-3.004-6-7-6-7 2.808-7 6c0 1.468.617 2.83 1.678 3.894m-.493 3.905a22 22 0 0 1-.713.129c-.2.032-.352-.176-.273-.362a10 10 0 0 0 .244-.637l.003-.01c.248-.72.45-1.548.524-2.319C.743 11.37 0 9.76 0 8c0-3.866 3.582-7 8-7s8 3.134 8 7-3.582 7-8 7a9 9 0 0 1-2.347-.306c-.52.263-1.639.742-3.468 1.105"/>
                </svg>
                <p class="mb-0">@Localizer["Messaging_NoConversations"]</p>
            </div>
        }
        else
        {
            <div class="list-group shadow-sm rounded overflow-hidden">
                @foreach (var item in Model.Conversations)
                {
                    var initials = string.Join("", item.ParticipantName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => w[0])).ToUpper();

                    <a asp-action="Details" asp-route-id="@item.ConversationId"
                       class="list-group-item list-group-item-action conversation-item py-3 @(item.UnreadCount > 0 ? "unread" : "")">
                        <div class="d-flex align-items-center">
                            <div class="chat-avatar me-3">@initials</div>
                            <div class="flex-grow-1 overflow-hidden">
                                <div class="d-flex justify-content-between align-items-baseline">
                                    <h6 class="mb-0 text-truncate @(item.UnreadCount > 0 ? "fw-bold" : "")">@item.ParticipantName</h6>
                                    <small class="text-muted ms-2 flex-shrink-0">@item.LastActivityAt.ToString("dd MMM HH:mm")</small>
                                </div>
                                <div class="d-flex justify-content-between align-items-center mt-1">
                                    <p class="mb-0 text-muted small text-truncate">
                                        @(item.LastMessagePreview ?? Localizer["Messaging_NoMessages"].Value)
                                    </p>
                                    @if (item.UnreadCount > 0)
                                    {
                                        <span class="badge bg-primary rounded-pill ms-2 flex-shrink-0">@item.UnreadCount</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </a>
                }
            </div>

            @if (Model.TotalPages > 1)
            {
                <nav class="mt-3">
                    <ul class="pagination pagination-sm justify-content-center">
                        @for (var i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@i">@i</a>
                            </li>
                        }
                    </ul>
                </nav>
            }
        }
    </div>
</div>
