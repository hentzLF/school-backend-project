@model AgriMarket.Web.Areas.Client.ViewModels.MyListings.ManageAvailabilitiesViewModel

@{
    ViewData["Title"] = Localizer["ManageAvailabilitiesFor", Model.ListingTitle].Value;
}

<h1>@Localizer["ManageAvailabilitiesFor", Model.ListingTitle]</h1>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<div class="mb-4">
    <a asp-action="Details" asp-route-id="@Model.ListingId" class="btn btn-secondary">@Localizer["BackToDetails"]</a>
</div>

<div class="row">
    <div class="col-md-8">
        <h3>@Localizer["ExistingSlots"]</h3>
        @if (Model.Availabilities.Any())
        {
            <table class="table">
                <thead>
                    <tr>
                        <th>@Localizer["StartTime"]</th>
                        <th>@Localizer["EndTime"]</th>
                        <th>@Localizer["Status"]</th>
                        <th>@Localizer["Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var slot in Model.Availabilities)
                    {
                        <tr>
                            <td>@slot.StartTime.ToString("g")</td>
                            <td>@slot.EndTime.ToString("g")</td>
                            <td>
                                @if (slot.IsBooked)
                                {
                                    <span class="badge bg-success">@Localizer["Booked"]</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@Localizer["Available"]</span>
                                }
                            </td>
                            <td>
                                @if (!slot.IsBooked)
                                {
                                    <form asp-action="DeleteAvailability" method="post" style="display:inline;">
                                        <input type="hidden" name="id" value="@slot.Id" />
                                        <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('@Localizer["ConfirmDeleteSlot"]');">@Localizer["Delete"]</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p>@Localizer["NoAvailabilitiesFound"]</p>
        }
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h3 class="card-title">@Localizer["AddNewSlot"]</h3>
                <form asp-action="AddAvailability" method="post">
                    <input type="hidden" asp-for="ListingId" />

                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="form-group mb-3">
                        <label asp-for="AddStartTime" class="control-label"></label>
                        <input asp-for="AddStartTime" class="form-control" type="datetime-local" />
                        <span asp-validation-for="AddStartTime" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="AddEndTime" class="control-label"></label>
                        <input asp-for="AddEndTime" class="form-control" type="datetime-local" />
                        <span asp-validation-for="AddEndTime" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary">@Localizer["AddSlot"]</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
