@model AgriMarket.Web.Areas.Client.ViewModels.MyListings.MyListingCreateViewModel

@{
    ViewData["Title"] = "Create Listing";
}

<h1>Create Listing</h1>

<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <div class="form-group mb-3">
                <label asp-for="Title" class="control-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Description" class="control-label"></label>
                <textarea asp-for="Description" class="form-control"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ServiceCategoryId" class="control-label"></label>
                <select asp-for="ServiceCategoryId" asp-items="Model.Categories" class="form-control">
                    <option value="">-- Select Category --</option>
                </select>
                <span asp-validation-for="ServiceCategoryId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="PricePerHectare" class="control-label"></label>
                <input asp-for="PricePerHectare" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="PricePerHectare" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}