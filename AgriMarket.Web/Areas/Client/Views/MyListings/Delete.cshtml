@model AgriMarket.Web.Areas.Client.ViewModels.MyListings.MyListingDetailsViewModel

@{
    ViewData["Title"] = "Delete Listing";
}

<h1>Delete Listing</h1>

@if (ViewBag.HasActiveBookings == true)
{
    <div class="alert alert-danger">
        <strong>Warning:</strong> You cannot delete this listing because it has active bookings. Please complete or cancel all active bookings before attempting to delete.
    </div>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">Back to Details</a>
}
else
{
    <h3>Are you sure you want to delete this listing?</h3>
    <div>
        <h4>@Model.Title</h4>
        <hr />
        
        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <input type="submit" value="Delete" class="btn btn-danger" /> |
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
}
