@model AgriMarket.Web.Areas.Client.ViewModels.MyListings.MyListingDetailsViewModel

@{
    ViewData["Title"] = "Listing Details";
}

<h1>Listing Details</h1>

<div>
    <h4>@Model.Title</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Category</dt>
        <dd class="col-sm-10">@Model.CategoryName</dd>

        <dt class="col-sm-2">Description</dt>
        <dd class="col-sm-10">@Model.Description</dd>

        <dt class="col-sm-2">Price / Hectare</dt>
        <dd class="col-sm-10">@Model.PricePerHectare.ToString("C")</dd>

        <dt class="col-sm-2">Status</dt>
        <dd class="col-sm-10">
            @if (Model.IsActive)
            {
                <span class="badge bg-success">Active</span>
            }
            else
            {
                <span class="badge bg-secondary">Inactive</span>
            }
        </dd>

        <dt class="col-sm-2">Total Bookings</dt>
        <dd class="col-sm-10">@Model.TotalBookingCount</dd>
    </dl>
</div>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
    
    <form asp-action="ToggleActive" asp-route-id="@Model.Id" method="post" style="display:inline;">
        <button type="submit" class="btn btn-warning">
            @(Model.IsActive ? "Deactivate" : "Activate")
        </button>
    </form>
    
    <a asp-action="Bookings" asp-route-id="@Model.Id" class="btn btn-info">View Bookings</a>
    <a asp-action="Availabilities" asp-route-id="@Model.Id" class="btn btn-secondary">Manage Slots</a>
    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Delete</a>
    
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>
