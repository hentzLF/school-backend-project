@model AgriMarket.Web.Areas.Client.ViewModels.MyListings.MyListingEditViewModel

@{
    ViewData["Title"] = Localizer["EditListing"].Value;
}

<h1>@Localizer["EditListing"]</h1>

<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />

            <div class="form-group mb-3">
                <label asp-for="Title" class="control-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Description" class="control-label"></label>
                <textarea asp-for="Description" class="form-control"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ServiceCategoryId" class="control-label"></label>
                <select asp-for="ServiceCategoryId" asp-items="Model.Categories" class="form-control">
                    <option value="">@Localizer["SelectCategoryDefault"]</option>
                </select>
                <span asp-validation-for="ServiceCategoryId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="PricePerHectare" class="control-label"></label>
                <input asp-for="PricePerHectare" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="PricePerHectare" class="text-danger"></span>
            </div>

            <div class="form-group form-check mb-3">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="IsActive" /> @Html.DisplayNameFor(model => model.IsActive)
                </label>
            </div>

            <div class="form-group">
                <input type="submit" value="@Localizer["Save"]" class="btn btn-primary" />
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">@Localizer["Cancel"]</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}