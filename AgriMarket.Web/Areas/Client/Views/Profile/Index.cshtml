@model AgriMarket.Web.Areas.Client.ViewModels.Profile.ProfileViewModel
@{
    ViewData["Title"] = Localizer["MyProfile"].Value;
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <h4 class="mb-0">@Localizer["MyProfile"]</h4>
    <a asp-area="Client" asp-controller="Profile" asp-action="Edit" class="btn btn-sm btn-outline-primary">
        @Localizer["EditProfile"]
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card" style="max-width: 540px;">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">@Localizer["FirstName"]</dt>
            <dd class="col-sm-8">@Model.FirstName</dd>

            <dt class="col-sm-4">@Localizer["LastName"]</dt>
            <dd class="col-sm-8">@Model.LastName</dd>

            <dt class="col-sm-4">@Localizer["Role"]</dt>
            <dd class="col-sm-8">
                <span class="badge text-bg-success">@Model.Role</span>
            </dd>

            <dt class="col-sm-4">@Localizer["Bio"]</dt>
            <dd class="col-sm-8">@(Model.Bio ?? "—")</dd>

            <dt class="col-sm-4">@Localizer["AvatarUrl"]</dt>
            <dd class="col-sm-8">
                @if (!string.IsNullOrWhiteSpace(Model.AvatarUrl))
                {
                    <a href="@Model.AvatarUrl" target="_blank" rel="noopener">@Model.AvatarUrl</a>
                }
                else
                {
                    <span class="text-muted">—</span>
                }
            </dd>
        </dl>
    </div>
</div>
