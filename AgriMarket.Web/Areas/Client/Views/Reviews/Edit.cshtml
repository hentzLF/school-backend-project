@model AgriMarket.Web.Areas.Client.ViewModels.Reviews.EditReviewViewModel
@{
    ViewData["Title"] = Localizer["Reviews_Edit_Title"].Value;
}

<h4 class="mb-4">@Localizer["Reviews_Edit_Title"]</h4>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">@Model.BookingTitle</div>
            <div class="card-body">
                <form asp-area="Client" asp-controller="Reviews" asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="ReviewId" />
                    <input type="hidden" asp-for="BookingId" />
                    <input type="hidden" asp-for="BookingTitle" />

                    <div class="mb-3">
                        <label class="form-label fw-bold">@Localizer["Reviews_Rating_Label"]</label>
                        <div>
                            @for (int i = 1; i <= 5; i++)
                            {
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" asp-for="Rating" value="@i" id="rating_@i" />
                                    <label class="form-check-label" for="rating_@i">@i</label>
                                </div>
                            }
                        </div>
                        <span asp-validation-for="Rating" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Comment" class="form-label">@Localizer["Reviews_Comment_Label"]</label>
                        <textarea asp-for="Comment" class="form-control" rows="4"
                                  placeholder="@Localizer["Reviews_Comment_Placeholder"]"></textarea>
                        <span asp-validation-for="Comment" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-area="Client" asp-controller="Bookings" asp-action="Details"
                           asp-route-id="@Model.BookingId" class="btn btn-outline-secondary">@Localizer["Cancel"]</a>
                        <button type="submit" class="btn btn-primary">@Localizer["Reviews_Edit_Submit"]</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
