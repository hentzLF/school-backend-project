<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AgriMarket</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand" asp-area="Client" asp-controller="Listings" asp-action="Index">AgriMarket</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#clientNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="clientNav">
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Listings" ? "active" : "")"
                       asp-area="Client" asp-controller="Listings" asp-action="Index">
                        @Localizer["Listings"]
                    </a>
                </li>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    @if (User.HasClaim(System.Security.Claims.ClaimTypes.Role, "Provider"))
                    {
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "MyListings" ? "active" : "")"
                               asp-area="Client" asp-controller="MyListings" asp-action="Index">
                                @Localizer["MyListings"]
                            </a>
                        </li>
                    }
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Bookings" ? "active" : "")"
                           asp-area="Client" asp-controller="Bookings" asp-action="Index">
                            @Localizer["MyBookings"]
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Payments" ? "active" : "")"
                           asp-area="Client" asp-controller="Payments" asp-action="Index">
                            @Localizer["Payments"]
                        </a>
                    </li>
                }
            </ul>
            <ul class="navbar-nav ms-auto align-items-center">
                <li class="nav-item">
                    <partial name="_LanguageSwitcher" />
                </li>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Profile" ? "active" : "")"
                           asp-area="Client" asp-controller="Profile" asp-action="Index">
                            @Localizer["Profile"]
                        </a>
                    </li>
                    <li class="nav-item">
                        <form asp-area="Client" asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-link nav-link">@Localizer["Logout"]</button>
                        </form>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Login" ? "active" : "")"
                           asp-area="Client" asp-controller="Account" asp-action="Login">
                            @Localizer["Login"]
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Register" ? "active" : "")"
                           asp-area="Client" asp-controller="Account" asp-action="Register">
                            @Localizer["Register"]
                        </a>
                    </li>
                }
            </ul>
        </div>
    </div>
</nav>
<main class="container mt-4">
    @RenderBody()
</main>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
